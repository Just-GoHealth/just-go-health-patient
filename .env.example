# Backend v2 API origin. The app proxies the API at its own root path
# (/auth, /me, /patients, /campuses, /campus-types, /versions/<code>…) through
# Next.js rewrites, so the browser only talks to this app's origin.
# Set per environment in the Vercel project:
#   Production:        https://justgo.up.railway.app
#   Staging / preview: https://jgohealth-backend-staging.up.railway.app
NEXT_PUBLIC_API_BASE_URL=https://jgohealth-backend-staging.up.railway.app
